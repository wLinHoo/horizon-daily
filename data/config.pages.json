{
  "ai": {
    "provider": "deepseek",
    "model": "DeepSeek-V4.1-Flash-1017",
    "base_url": "https://www.autodl.art/api/v1",
    "api_key_env": "AUTODL_API_KEY",
    "languages": ["zh"],
    "max_tokens": 8192,
    "analysis_concurrency": 2,
    "enrichment_concurrency": 2
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 12,
      "min_score": 80,
      "category": "tech-companies",
      "profile": "tech-news"
    },
    "reddit": {"enabled": false},
    "telegram": {
      "enabled": true,
      "channels": [
        {"channel": "AI_News_CN", "fetch_limit": 6, "category": "ai", "profile": "tech-news"},
        {"channel": "zaihuapd", "fetch_limit": 8, "category": "tech-companies", "profile": "tech-news"}
      ]
    },
    "twitter": {
      "enabled": true,
      "actor_id": "xquik~x-tweet-scraper",
      "apify_max_total_charge_usd": 0.05,
      "users": ["OpenAI", "OpenAIDevs", "OpenAINewsroom", "AnthropicAI", "claudeai", "GoogleDeepMind", "deepseek_ai"],
      "fetch_limit": 40,
      "category": "ai",
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "category": "ai",
        "profile": "tech-news"
      },
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "category": "ai",
        "profile": "tech-news"
      },
      {
        "name": "OpenAI Codex Releases",
        "url": "https://github.com/openai/codex/releases.atom",
        "category": "ai",
        "profile": "tech-news"
      },
      {
        "name": "Claude Code Releases",
        "url": "https://github.com/anthropics/claude-code/releases.atom",
        "category": "ai",
        "profile": "tech-news"
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "category": "ai",
        "profile": "tech-news"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "category": "ai",
        "profile": "tech-news"
      },
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "category": "ai",
        "profile": "tech-news"
      },
      {
        "name": "The Verge Tech",
        "url": "https://www.theverge.com/rss/tech/index.xml",
        "category": "tech-companies",
        "profile": "tech-news"
      },
      {
        "name": "SCMP Technology",
        "url": "https://www.scmp.com/rss/36/feed",
        "category": "tech-companies",
        "profile": "tech-news"
      },
      {
        "name": "NVIDIA Newsroom",
        "url": "https://nvidianews.nvidia.com/cats/press_release.xml",
        "category": "tech-companies",
        "profile": "tech-news"
      },
      {
        "name": "Investing.com Stock Market News",
        "url": "https://www.investing.com/rss/news_25.rss",
        "category": "markets",
        "profile": "finance-news"
      }
    ],
    "google_news": {
      "enabled": true,
      "query": "(Nasdaq OR \"AI stocks\" OR \"chip stocks\" OR OpenAI OR Anthropic OR DeepSeek OR Nvidia OR AMD OR Microsoft OR Alphabet OR Meta OR Amazon OR Apple OR TSMC OR ASML OR Alibaba OR Tencent OR Baidu) (earnings OR guidance OR \"capital spending\" OR regulation OR \"export controls\" OR acquisition OR IPO OR \"stock market\")",
      "language": "en",
      "country": "US",
      "max_results": 12,
      "category": "markets",
      "profile": "finance-news"
    }
  },
  "collection": {"time_window_hours": 24},
  "digest": {
    "max_items": 14,
    "group_by": "category",
    "profile_order": ["tech-news", "finance-news"],
    "category_groups": {
      "ai": {"name": "AI 进展", "limit": 7, "categories": ["ai"]},
      "tech-companies": {"name": "科技公司", "limit": 4, "categories": ["tech-companies"]},
      "markets": {"name": "股市与市场", "limit": 4, "categories": ["markets"]}
    }
  },
  "processing": {
    "profile_settings": {
      "tech-news": {"threshold": 5.0},
      "finance-news": {"threshold": 6.0}
    }
  }
}
